{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=UsableLifeCalendar.db"
  },
  "Jwt": {
    "Issuer": "UsableLifeCalendar",
    "Audience": "UsableLifeCalendar",
    "ExpiryMinutes": 60
  },
  "EventRules": {
    "MaxApprovedPerDay": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}